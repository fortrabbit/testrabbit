# testrabbit environment (zero-dependency plain PHP — IN-1649)

# "uni" or "pro". Pro-only tests are skipped on uni apps.
APP_TYPE=pro

# One of: ubuntu18, ubuntu20, ubuntu22, ubuntu24, new (k8s). Drives Imagick formats.
FRBIT_PLATFORM=ubuntu22

# MySQL feature test
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=testrabbit
DB_USERNAME=root
DB_PASSWORD=pwd

# MongoDB feature test (full connection string)
MONGODB_CONNECTION="mongodb+srv://testrabbit:XXX@clusterXXX.mongodb.net/test?retryWrites=true&w=majority"
